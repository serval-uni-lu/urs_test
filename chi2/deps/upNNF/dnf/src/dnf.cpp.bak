        //std::cout << "lvl h " << level_high << "\n";
        //std::cout << "lit l " << lits_low << "\n";
        //std::cout << "lit h " << lits_high << "\n";

        delete solver;
    }
    catch(std::exception & e) {
        std::cerr << "ERROR: " << e.what() << "\n";
        return 1;
    }

    return 0;
}

